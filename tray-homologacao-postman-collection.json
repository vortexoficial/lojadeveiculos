{
  "info": {
    "name": "Homologacao Tray - Evidencias",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "api_address", "value": "https://SUA_LOJA.commercesuite.com.br/web_api" },
    { "key": "consumer_key", "value": "SUA_CONSUMER_KEY" },
    { "key": "consumer_secret", "value": "SUA_CONSUMER_SECRET" },
    { "key": "code", "value": "SEU_CODE" },
    { "key": "access_token", "value": "SEU_ACCESS_TOKEN" },
    { "key": "refresh_token", "value": "SEU_REFRESH_TOKEN" },
    { "key": "category_id", "value": "1" },
    { "key": "product_id", "value": "1" },
    { "key": "variant_id", "value": "1" },
    { "key": "order_id", "value": "1" },
    { "key": "invoice_id", "value": "1" },
    { "key": "public_image_url", "value": "https://exemplo.com/imagem-teste.jpg" },
    { "key": "webhook_url", "value": "https://exemplo.com/webhook/tray" }
  ],
  "item": [
    {
      "name": "01 - Geracao de Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "consumer_key", "value": "{{consumer_key}}", "type": "text" },
            { "key": "consumer_secret", "value": "{{consumer_secret}}", "type": "text" },
            { "key": "code", "value": "{{code}}", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{api_address}}/auth",
          "host": ["{{api_address}}"],
          "path": ["auth"]
        }
      }
    },
    {
      "name": "02 - Renovar Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_address}}/auth?refresh_token={{refresh_token}}",
          "host": ["{{api_address}}"],
          "path": ["auth"],
          "query": [
            { "key": "refresh_token", "value": "{{refresh_token}}" }
          ]
        }
      }
    },
    {
      "name": "04 - API de categoria - Listar categorias",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_address}}/categories/?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["categories", ""],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    },
    {
      "name": "04 - API de categoria - Arvore",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_address}}/categories/tree/{{category_id}}?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["categories", "tree", "{{category_id}}"],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    },
    {
      "name": "05 - API de Produtos - Listar produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_address}}/products?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["products"],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    },
    {
      "name": "05 - API de Produtos - Cadastrar produto teste",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "[\"Product\"][\"name\"]", "value": "Produto Teste API", "type": "text" },
            { "key": "[\"Product\"][\"description\"]", "value": "Descricao do produto de teste da API", "type": "text" },
            { "key": "[\"Product\"][\"description_small\"]", "value": "Produto de teste da API", "type": "text" },
            { "key": "[\"Product\"][\"price\"]", "value": "10.01", "type": "text" },
            { "key": "[\"Product\"][\"cost_price\"]", "value": "10.01", "type": "text" },
            { "key": "[\"Product\"][\"stock\"]", "value": "100", "type": "text" },
            { "key": "[\"Product\"][\"category_id\"]", "value": "{{category_id}}", "type": "text" },
            { "key": "[\"Product\"][\"available\"]", "value": "1", "type": "text" },
            { "key": "[\"Product\"][\"available_in_store\"]", "value": "1", "type": "text" },
            { "key": "[\"Product\"][\"reference\"]", "value": "TESTE-API-001", "type": "text" },
            { "key": "[\"Product\"][\"weight\"]", "value": "1000", "type": "text" },
            { "key": "[\"Product\"][\"length\"]", "value": "10", "type": "text" },
            { "key": "[\"Product\"][\"width\"]", "value": "10", "type": "text" },
            { "key": "[\"Product\"][\"height\"]", "value": "10", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{api_address}}/products?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["products"],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    },
    {
      "name": "06 - API de variacao - Listar variacoes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_address}}/products/variants/?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["products", "variants", ""],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    },
    {
      "name": "06 - API de variacao - Cadastrar variacao teste",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "[\"Variant\"][\"product_id\"]", "value": "{{product_id}}", "type": "text" },
            { "key": "[\"Variant\"][\"ean\"]", "value": "ABC123", "type": "text" },
            { "key": "[\"Variant\"][\"order\"]", "value": "1", "type": "text" },
            { "key": "[\"Variant\"][\"price\"]", "value": "12.00", "type": "text" },
            { "key": "[\"Variant\"][\"cost_price\"]", "value": "10.00", "type": "text" },
            { "key": "[\"Variant\"][\"stock\"]", "value": "20", "type": "text" },
            { "key": "[\"Variant\"][\"minimum_stock\"]", "value": "1", "type": "text" },
            { "key": "[\"Variant\"][\"reference\"]", "value": "VAR-TESTE-001", "type": "text" },
            { "key": "[\"Variant\"][\"weight\"]", "value": "1000", "type": "text" },
            { "key": "[\"Variant\"][\"length\"]", "value": "10", "type": "text" },
            { "key": "[\"Variant\"][\"width\"]", "value": "10", "type": "text" },
            { "key": "[\"Variant\"][\"height\"]", "value": "10", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{api_address}}/products/variants/?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["products", "variants", ""],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    },
    {
      "name": "07 - API de imagem - Produto",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Images\": {\n    \"picture_source_1\": \"{{public_image_url}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{api_address}}/products/{{product_id}}/images?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["products", "{{product_id}}", "images"],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    },
    {
      "name": "07 - API de imagem - Variacao",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Images\": {\n    \"picture_source_1\": \"{{public_image_url}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{api_address}}/variants/{{variant_id}}/images?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["variants", "{{variant_id}}", "images"],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    },
    {
      "name": "09 - API de nota fiscal - Listar notas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_address}}/orders/invoices?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["orders", "invoices"],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    },
    {
      "name": "09 - API de nota fiscal - Consultar nota",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_address}}/orders/{{order_id}}/invoices/{{invoice_id}}?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["orders", "{{order_id}}", "invoices", "{{invoice_id}}"],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    },
    {
      "name": "09 - Webhook - Simular notificacao recebida",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "seller_id", "value": "391250", "type": "text" },
            { "key": "scope_id", "value": "{{order_id}}", "type": "text" },
            { "key": "scope_name", "value": "order", "type": "text" },
            { "key": "act", "value": "update", "type": "text" },
            { "key": "app_code", "value": "718", "type": "text" },
            { "key": "url_notification", "value": "{{webhook_url}}", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{webhook_url}}",
          "host": ["{{webhook_url}}"]
        }
      }
    },
    {
      "name": "10 - Demais APIs - Informacoes da loja",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_address}}/info?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["info"],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    },
    {
      "name": "10 - Demais APIs - Listagem de pedidos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_address}}/orders?access_token={{access_token}}",
          "host": ["{{api_address}}"],
          "path": ["orders"],
          "query": [
            { "key": "access_token", "value": "{{access_token}}" }
          ]
        }
      }
    }
  ]
}
